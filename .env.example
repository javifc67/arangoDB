# ===============================================
# Configuración Local (Docker Compose / Local DB)
# ===============================================
ARANGO_ROOT_PASSWORD=rootpassword
ARANGO_PORT=8529

# Nombre de la base de datos LOCAL donde se importarán los datos.
# Si no es "_system", se creará automáticamente.
# Para import_all.py: también determina la carpeta dentro de /data/ a usar.
LOCAL_DB_NAME=Cacharreo_UPM

# ===============================================
# Configuración Remota (para export_all.py)
# ===============================================
host_url=https://tu-instancia.arango.ai:443
host_username=tu_usuario
host_password=tu_password

# Nombre de la base de datos REMOTA a exportar (clona TODA la BD)
db_name=tu_base_de_datos