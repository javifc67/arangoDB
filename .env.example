# ===============================================
# Configuración Local (Docker Compose / Local DB)
# ===============================================
ARANGO_ROOT_PASSWORD=rootpassword
ARANGO_PORT=8529

# Nombre de la base de datos LOCAL donde se importarán los datos.
# Si no es "_system", se creará automáticamente.
# Para import_all.py: también determina la carpeta dentro de /data/ a usar.
LOCAL_DB_NAME=_system

# ===============================================
# Configuración Remota (para export_all.py y export_movies.py)
# ===============================================
host_url=https://tu-instancia.arango.ai:443
host_username=tu_usuario
host_password=tu_password

# Nombre de la base de datos REMOTA a exportar (clona TODA la BD)
db_name=tu_base_de_datos

# ===============================================
# Opciones avanzadas de import_all.py (opcionales)
# ===============================================
# Carpeta dentro de /data/ a importar si difiere de LOCAL_DB_NAME / TARGET_DB_NAME
# SOURCE_FOLDER=nombre_carpeta_dump

# Para importar hacia una instancia distinta de localhost:ARANGO_PORT
# TARGET_URL=https://tu-destino.arango.ai:443
# TARGET_USERNAME=tu_usuario_destino
# TARGET_PASSWORD=tu_password_destino
# TARGET_DB_NAME=tu_bd_destino
# IMPORT_BATCH_SIZE=2000
# IMPORT_BATCH_DELAY=0.05